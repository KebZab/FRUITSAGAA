{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", "build"]
}
